# Copy to .env and fill in. NEVER commit the real .env file.

# --- Auditor LLM (llm_auditor.py) -----------------------------------------
# Provider is picked with --provider (auto|anthropic|openai|offline).
# "auto" uses Anthropic if ANTHROPIC_API_KEY is set, else an OpenAI-compatible
# endpoint if OPENAI_API_KEY is set, else the labelled offline fallback.
ANTHROPIC_API_KEY=your-anthropic-key-here
AUDITOR_ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible chat-completions endpoint with tool/function calling
# (OpenAI, Azure OpenAI, Groq, OpenRouter, vLLM, Ollama's /v1 endpoint, ...)
OPENAI_API_KEY=your-openai-compatible-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
AUDITOR_OPENAI_MODEL=your-model-name-here

# Embeddings for the vector store: "hashing" (offline default),
# "openai:<model>" (OpenAI-compatible /embeddings) or "sentence-transformers:<model>"
AUDITOR_EMBEDDER=hashing

# --- Collection (collect_and_annotate.py) ---------------------------------
# Wikimedia asks automated clients to identify themselves. Use real contact info.
COLLECTOR_USER_AGENT=AugleAssessmentBot/1.0 (educational project; contact: you@example.com)
# Optional: path to a Chromium/Chrome executable if `playwright install chromium` is not possible
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Experiment tracking (train.py --tracker wandb) -----------------------
WANDB_API_KEY=your-wandb-key-here
WANDB_PROJECT=augle-ai-assessment
